# 5G SA Core Network (Open5GS) + RAN configuration
# Copy to .env before running docker compose. scripts/env/start_env.sh does this automatically if .env is missing.

MCC=001
MNC=01
TAC=7

NETWORK_NAME=Open5GS

# Docker compose network used by UERANSIM smoke tests
DOCKER_NETWORK_NAME=compose_5gc

# 5GC internal network
CORE_NETWORK=172.22.0.0/24

# --- 5GC NF IPs (internal network) ---
MONGO_IP=172.22.0.2
WEBUI_IP=172.22.0.26
NRF_IP=172.22.0.12
SCP_IP=172.22.0.35
AUSF_IP=172.22.0.11
UDR_IP=172.22.0.14
UDM_IP=172.22.0.13
PCF_IP=172.22.0.27
BSF_IP=172.22.0.29
NSSF_IP=172.22.0.28
SMF_IP=172.22.0.7
AMF_IP=172.22.0.10
UPF_IP=172.22.0.8
PCRF_IP=172.22.0.4
PCRF_BIND_PORT=3873
OCS_IP=172.22.0.40
OCS_BIND_PORT=3872
OSMOEPDG_IP=172.22.0.41

# --- RAN-facing IPs (on ran network 10.53.1.0/24) ---
AMF_RAN_IP=10.53.1.2
UPF_RAN_IP=10.53.1.3

# --- RAN component IPs ---
CU_CP_IP=10.53.1.4
CU_UP_IP=10.53.1.5
CU_UP_F1U_IP=172.18.10.2
DU_IP=10.53.1.6
DU_F1U_IP=172.18.10.3

# --- srsUE 5G ZMQ smoke test ---
RAN_NETWORK_NAME=compose_ran
SRS_GNB_IP=10.53.1.6
SRS_UE_IP=10.53.1.7
SRSUE_RADIO_MODE=multi
SRS_ZMQ_PRB=52
SRS_ZMQ_SRATE_HZ=11.52e6
SRS_ZMQ_SSB_ARFCN=367930
SRSUE_RECREATE_DU=1

# --- monolithic gNB + srsUE ZMQ control smoke test ---
SRS_CONTROL_GNB_IP=10.53.1.8
SRS_CONTROL_UE_IP=10.53.1.9
SRS_CONTROL_BW_MHZ=10
SRS_CONTROL_PRB=52
SRS_CONTROL_SRATE_MHZ=11.52
SRS_CONTROL_SRATE_HZ=11.52e6
SRS_CONTROL_CORESET0_INDEX=0
SRS_CONTROL_SSB_ARFCN=367930
SRS_CONTROL_TIME_ALIGNMENT=0
SRSUE_TIME_ADV_NSAMPLES=0

# --- UPF ---
UPF_ADVERTISE_IP=10.53.1.3
UPF_TUNTAP_MODE=tun
UPF_INTERNET_APN_IF_NAME=ogstun
UPF_IMS_APN_IF_NAME=ogstun2
SMF_DNS1=8.8.8.8
SMF_DNS2=8.8.4.4

# --- UE subscriber ---
UE1_IMSI=001010123456780
UE1_KI=00112233445566778899aabbccddeeff
UE1_OP=11111111111111111111111111111111
UE1_AMF=8000
UE1_IMEI=356938035643803
UE1_IMEISV=4370816125816151

# --- UERANSIM 5G Core smoke test ---
NR_GNB_IP=172.22.0.23
NR_UE_IP=172.22.0.24

# --- UE IP pool ---
UE_IPV4_INTERNET=10.45.0.0/24
UE_IPV4_IMS=10.45.1.0/24

# --- P-CSCF (placeholder, not used without IMS) ---
PCSCF_IP=172.22.0.21

MAX_NUM_UE=1024
