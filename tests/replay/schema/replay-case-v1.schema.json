{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "description": {
      "type": "string"
    },
    "expect": {
      "additionalProperties": false,
      "properties": {
        "display_filter": {
          "minLength": 1,
          "type": "string"
        },
        "fields": {
          "additionalProperties": {
            "type": [
              "string",
              "integer"
            ]
          },
          "minProperties": 1,
          "type": "object"
        },
        "packet_count": {
          "minimum": 1,
          "type": "integer"
        }
      },
      "required": [
        "display_filter",
        "fields",
        "packet_count"
      ],
      "type": "object"
    },
    "id": {
      "pattern": "^[a-z0-9_]+$",
      "type": "string"
    },
    "packet": {
      "additionalProperties": false,
      "properties": {
        "ethernet": {
          "$ref": "#/$defs/ethernet"
        },
        "gtpu": {
          "$ref": "#/$defs/gtpu"
        },
        "icmp_echo": {
          "$ref": "#/$defs/icmpEcho"
        },
        "inner_ipv4": {
          "$ref": "#/$defs/ipv4"
        },
        "outer_ipv4": {
          "$ref": "#/$defs/ipv4"
        },
        "udp": {
          "$ref": "#/$defs/udp"
        }
      },
      "required": [
        "ethernet",
        "outer_ipv4",
        "udp",
        "gtpu",
        "inner_ipv4",
        "icmp_echo"
      ],
      "type": "object"
    },
    "protocol": {
      "const": "GTP-U"
    },
    "schema_version": {
      "const": 1
    }
  },
  "required": [
    "schema_version",
    "id",
    "description",
    "protocol",
    "packet",
    "expect"
  ],
  "type": "object",
  "$defs": {
    "ethernet": {
      "additionalProperties": false,
      "properties": {
        "dst": {
          "type": "string"
        },
        "ethertype": {
          "type": [
            "string",
            "integer"
          ]
        },
        "src": {
          "type": "string"
        }
      },
      "required": [
        "src",
        "dst"
      ],
      "type": "object"
    },
    "gtpu": {
      "additionalProperties": false,
      "properties": {
        "flags": {
          "type": [
            "string",
            "integer"
          ]
        },
        "message_type": {
          "type": [
            "string",
            "integer"
          ]
        },
        "teid": {
          "type": [
            "string",
            "integer"
          ]
        }
      },
      "required": [
        "teid"
      ],
      "type": "object"
    },
    "icmpEcho": {
      "additionalProperties": false,
      "properties": {
        "code": {
          "type": [
            "string",
            "integer"
          ]
        },
        "identifier": {
          "type": [
            "string",
            "integer"
          ]
        },
        "payload": {
          "type": "string"
        },
        "sequence": {
          "type": [
            "string",
            "integer"
          ]
        },
        "type": {
          "type": [
            "string",
            "integer"
          ]
        }
      },
      "type": "object"
    },
    "ipv4": {
      "additionalProperties": false,
      "properties": {
        "dst": {
          "type": "string"
        },
        "identification": {
          "type": [
            "string",
            "integer"
          ]
        },
        "src": {
          "type": "string"
        },
        "ttl": {
          "type": [
            "string",
            "integer"
          ]
        }
      },
      "required": [
        "src",
        "dst"
      ],
      "type": "object"
    },
    "udp": {
      "additionalProperties": false,
      "properties": {
        "dst_port": {
          "type": [
            "string",
            "integer"
          ]
        },
        "src_port": {
          "type": [
            "string",
            "integer"
          ]
        }
      },
      "type": "object"
    }
  }
}
